# BlindTag API Configuration Example
# 이 파일을 복사하여 .env 로 이름을 변경한 후 실제 Supabase 접속 정보를 입력하세요.

# 1. 서버 구동 포트 (GCP Cloud Run은 배포 시 자동으로 PORT=8080 주입)
PORT=8080
APP_ENV=development

# 2. Supabase PostgreSQL 연결 문자열 (Direct or Connection Pooler)
# Supabase 대시보드 > Project Settings > Database > Connection string > URI (Transaction mode 권장)
# 예: postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-supabase-password@db.xxxx.supabase.co:5432/postgres?sslmode=require

# 3. Supabase REST API & Storage 연동 키 (선택 사항)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. CORS 허용 도메인 (전체 허용 시 * 또는 쉼표 구분)
CORS_ALLOWED_ORIGINS=*
